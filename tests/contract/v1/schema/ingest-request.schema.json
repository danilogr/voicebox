{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speak-telemetry/contract/v1/schema/ingest-request.schema.json",
  "title": "POST /v1/ingest request",
  "description": "One chunk of the client's unshipped backlog: the install snapshot, the sessions that are new or changed or that the utterances belong to, and the utterance rows themselves (possibly none). See CONTRACT.md for why all three travel together.",
  "type": "object",
  "additionalProperties": false,
  "required": ["install", "sessions", "utterances"],
  "properties": {
    "install": { "$ref": "#/$defs/install" },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" },
      "minItems": 0,
      "maxItems": 100
    },
    "utterances": {
      "type": "array",
      "items": { "$ref": "#/$defs/utterance" },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 32
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_id", "first_seen_at", "last_seen_at", "plugin_version", "os", "arch", "accel"],
      "properties": {
        "install_id": { "$ref": "#/$defs/uuid" },
        "first_seen_at": { "$ref": "#/$defs/timestamp" },
        "last_seen_at": { "$ref": "#/$defs/timestamp" },
        "plugin_version": { "$ref": "#/$defs/semver" },
        "disclosure_ver": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "maxLength": 35
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){1,2}$",
          "maxLength": 64
        },
        "utc_offset_min": { "type": "integer", "minimum": -720, "maximum": 840 },
        "os": { "type": "string", "enum": ["darwin", "linux", "win32"] },
        "os_version": {
          "type": "string",
          "pattern": "^(unknown|[0-9]+\\.[0-9]+)$",
          "maxLength": 16
        },
        "arch": { "type": "string", "enum": ["arm64", "x86_64"] },
        "cpu_model": { "type": "string", "maxLength": 128 },
        "cpu_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "ram_gb": { "type": "integer", "enum": [8, 16, 32, 64, 128] },
        "accel": { "type": "string", "enum": ["metal", "cuda", "rocm", "none", "unknown"] },
        "accel_name": { "type": "string", "maxLength": 128 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "install_id", "started_at", "plugin_version", "listen_enabled", "harness"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "install_id": { "$ref": "#/$defs/uuid" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "plugin_version": { "$ref": "#/$defs/semver" },
        "tts_engine": { "type": "string", "maxLength": 32 },
        "asr_engine": { "type": "string", "enum": ["nemo"] },
        "listen_enabled": { "type": "boolean" },
        "harness": { "type": "string", "enum": ["claude-code", "antigravity", "gemini-cli", "codex", "other", "unknown"] },
        "harness_version": { "type": "string", "maxLength": 64 }
      }
    },
    "utterance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utterance_id", "session_id", "install_id", "seq", "direction", "source", "occurred_at", "status"],
      "properties": {
        "utterance_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "install_id": { "$ref": "#/$defs/uuid" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "direction": { "type": "string", "enum": ["out", "in"] },
        "source": { "type": "string", "enum": ["speak", "listen", "talk", "transcribe"] },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "engine": { "type": "string", "maxLength": 32 },
        "model": { "type": "string", "maxLength": 64 },
        "voice": { "type": "string", "maxLength": 64 },
        "device_kind": { "type": "string", "enum": ["builtin", "usb", "bluetooth", "virtual", "unknown"] },
        "intent": {
          "type": "string",
          "enum": ["task_done", "blocked", "question", "recap", "progress", "takeaway", "conversation", "narration", "unspecified"]
        },
        "words": { "type": "integer", "minimum": 0, "maximum": 500000 },
        "chars": { "type": "integer", "minimum": 0, "maximum": 5000000 },
        "audio_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "queue_wait_ms": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "synth_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "play_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "asr_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "status": { "type": "string", "enum": ["ok", "failed", "discarded", "interrupted", "heard_nothing", "refused"] },
        "source_bytes": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
        "audio_codec": { "type": "string", "maxLength": 32, "pattern": "^[a-z0-9_]+$" },
        "converted": { "type": "boolean" },
        "diarize": { "type": "boolean" },
        "format": { "type": "string", "enum": ["text", "json", "srt", "vtt"] }
      },
      "allOf": [
        {
          "if": { "required": ["direction"], "properties": { "direction": { "const": "out" } } },
          "then": { "properties": { "device_kind": false, "asr_ms": false } }
        },
        {
          "if": { "required": ["direction"], "properties": { "direction": { "const": "in" } } },
          "then": {
            "properties": {
              "intent": false,
              "voice": false,
              "queue_wait_ms": false,
              "synth_ms": false,
              "play_ms": false
            }
          }
        },
        {
          "if": { "required": ["source"], "properties": { "source": { "const": "transcribe" } } },
          "then": { "properties": { "direction": { "const": "in" }, "device_kind": false } },
          "else": {
            "properties": {
              "source_bytes": false,
              "audio_codec": false,
              "converted": false,
              "diarize": false,
              "format": false,
              "audio_ms": { "type": "integer", "maximum": 600000 },
              "asr_ms": { "type": "integer", "maximum": 120000 },
              "words": { "type": "integer", "maximum": 20000 },
              "chars": { "type": "integer", "maximum": 150000 }
            }
          }
        }
      ]
    }
  }
}
